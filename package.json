{
  "name": "astro-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Open, deterministic symbolic infrastructure for builders and AI workflows",
  "license": "MIT",
  "author": "Sukara Technology",
  "repository": {
    "type": "git",
    "url": "https://github.com/nivaaz/astro-engine.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo coverage playwright-report test-results",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:boundaries": "vitest run tests/foundation",
    "private:ephemeris": "node scripts/fetch-swiss-ephemeris.mjs",
    "validate:swiss": "node scripts/validate-swiss-provider.mjs",
    "typecheck": "turbo run typecheck",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "performance:web": "node scripts/check-web-bundle.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
